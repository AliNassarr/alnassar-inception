[mysqld]
user                    = mysql
pid-file                = /run/mysqld/mariadb.pid
socket                  = /run/mysqld/mysqld.sock
port                    = 3306
basedir                 = /usr
datadir                 = /var/lib/mysql
tmpdir                  = /tmp
lc-messages-dir         = /usr/share/mariadb
bind-address            = 0.0.0.0
skip-networking         = 0
skip-name-resolve
